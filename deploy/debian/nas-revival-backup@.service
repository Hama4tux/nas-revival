[Unit]
Description=NAS Revival backup pull job %i
After=network-online.target
Wants=network-online.target

[Service]
# Started by the generated nas-revival-task-<id>.timer (backup-pull tasks) or by "Run now" in the web UI.
# Runs as the unprivileged account nas-backup: rsync over ssh from the server into
# <backupTarget share>/<folder>/<id>/current (mirror) and .../versions/<date>/ (hardlink snapshots), ADR 0008.
# The runner waits for the heavy-job lock (/run/lock/nas-heavy.lock, group nas-heavy).
Type=oneshot
ExecStart=/usr/local/bin/nas-revival task run -config /etc/nas-revival -state /var/lib/nas-backup %i
User=nas-backup
Group=nas-backup
SupplementaryGroups=nas-heavy
# History (task-history.json, 0640) and the ssh key live here; the web UI reads the history through
# its supplementary group nas-backup.
StateDirectory=nas-backup
StateDirectoryMode=0750
Nice=10
IOSchedulingClass=idle
# Waiting for the lock takes up to 3 h; a first full pull may run long.
TimeoutStartSec=12h
Environment=GOMEMLIMIT=40MiB GOGC=50
MemoryMax=160M
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
# One path for the data volume: hardlinks between apps/ and versions/ must not cross a mount (EXDEV).
ReadWritePaths=/srv/data /run/lock
