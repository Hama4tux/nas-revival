[Unit]
Description=NAS Revival privileged helper (network, DNS, NTP settings, SMART self-tests, disk power and activity, restart/shutdown, NAS users, shared folders, services, SMB, NFS)
Documentation=file:///usr/share/doc/nas-revival/adr-0003
# Started before the web UI so its socket exists; the web UI only Wants= it.
Before=nas-revival.service
# NFS (W2.6): the nfsd file system must be mounted before the sandbox is set up, otherwise the helper
# never sees /proc/fs/nfsd/clients (mounts below the read-only /proc/fs do not reach it). This loads the
# nfsd module (~360 KB) at boot even with NFS off; without nfs-kernel-server the unit does not exist and
# Wants= is ignored.
Wants=proc-fs-nfsd.mount
After=proc-fs-nfsd.mount
After=systemd-networkd.service systemd-resolved.service systemd-timesyncd.service local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/bin/nas-revival helper -socket /run/nas-revival-helper/helper.sock -user nas-revival -iface enp1s0
# systemd creates /run/nas-revival-helper (0750 root:root); the helper chowns the
# directory and the socket (0660) to group nas-revival, and checks SO_PEERCRED.
RuntimeDirectory=nas-revival-helper
RuntimeDirectoryMode=0750
# pending.json + backup of 20-wired.network for the 180 s rollback.
StateDirectory=nas-revival-helper
StateDirectoryMode=0700
# The timesyncd drop-in directory may not exist yet; the "+" mkdir runs unsandboxed first.
ExecStartPre=+/usr/bin/mkdir -p -m 0755 /etc/systemd/timesyncd.conf.d
# /etc/nas-revival/disks.json: standby timeout and APM per disk (ADR 0007), applied at start;
# /etc/nas-revival/credentials.json: web password hashes of NAS users (ADR 0004).
# NAS users (W2.1): useradd/usermod/chpasswd/gpasswd write /etc/passwd, group, shadow,
# gshadow, subuid/subgid through lock and temp files next to them, so the whole /etc
# directory must be writable – single-file entries are not enough. The helper only runs
# those tools with validated names, never with request-supplied paths.
# Shared folders (W2.3): the helper creates, sets ACLs on and removes folders on the data
# volumes under /srv and writes /etc/nas-revival/shares.json and the Samba fragment (/etc).
# Services (W2.4): systemctl start/stop/… over D-Bus for the fixed catalog, ss -p and journalctl read-only.
# SMB (W2.5): smb.conf in /etc; smbpasswd writes the passdb in /var/lib/samba/private,
# smbstatus and smbcontrol open the tdbs and message sockets in /run/samba and /var/lib/samba.
# NFS (W2.6): nfs.json and /etc/exports.d in /etc; exportfs -ra writes /var/lib/nfs/etab.
ReadWritePaths=/etc -/var/log/lastlog -/var/log/faillog -/srv -/var/lib/samba -/var/cache/samba -/run/samba -/var/lib/nfs
Environment=GOMEMLIMIT=16MiB GOGC=50
MemoryMax=48M
# Hardening. The helper stays root because it writes /etc/systemd/network and talks
# to networkd/timesyncd/resolved over D-Bus (AF_UNIX); `ip` needs AF_NETLINK.
# CapabilityBoundingSet is deliberately not set: networkctl/systemctl/resolvectl go
# through D-Bus and polkit treats root as authorised, but a too tight set breaks
# them in ways that are hard to see. NoNewPrivileges and the syscall/FS limits remain.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
# If the helper dies during a pending change, the marker in StateDirectory makes the
# next start roll back (or re-arm the remaining time).
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
