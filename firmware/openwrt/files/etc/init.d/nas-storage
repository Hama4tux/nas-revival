#!/bin/sh /etc/rc.common
# fstab (START=11) runs "block mount" before mdadm (START=13) assembles the
# data array, so md-backed mounts are skipped at boot. Mount them again once
# the arrays exist. Found in the OpenWrt 25.12.6 QEMU simulation.
START=14
USE_PROCD=1

start_service() {
	/sbin/block mount
}
