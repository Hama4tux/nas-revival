#!/bin/sh
# The mdadm package ships an example "config array" (fixed UUID, /dev/md0).
# Next to a real array on /dev/md0 it makes mdadm abort with "Duplicate MD
# device names" and nothing is assembled at boot. Drop the example once; real
# arrays are added by UUID. Found in the OpenWrt 25.12.6 QEMU simulation.
if [ "$(uci -q get mdadm.@array[0].uuid)" = "52c5c44a:d2162820:f75d3464:799750f8" ]; then
	uci delete mdadm.@array[0]
	uci commit mdadm
fi
exit 0
