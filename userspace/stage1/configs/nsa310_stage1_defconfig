BR2_arm=y
BR2_arm926t=y
BR2_ARM_EABI=y
BR2_ARM_SOFT_FLOAT=y
BR2_ARM_INSTRUCTIONS_ARM=y
BR2_TOOLCHAIN_BUILDROOT_UCLIBC=y
BR2_PTHREADS_NONE=y
BR2_GCC_VERSION_13_X=y
BR2_KERNEL_HEADERS_CUSTOM_TARBALL=y
BR2_KERNEL_HEADERS_CUSTOM_TARBALL_LOCATION="https://cdn.kernel.org/pub/linux/kernel/v2.6/linux-2.6.31.8.tar.xz"
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_REALLY_OLD=y
BR2_PACKAGE_HOST_LINUX_HEADERS_LICENSE_FILES="COPYING"
BR2_UCLIBC_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_NAS_REVIVAL_STAGE1_PATH)/uclibc.fragment"
