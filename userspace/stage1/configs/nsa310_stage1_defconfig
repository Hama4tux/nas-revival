# BR2_TARGET_ENABLE_ROOT_LOGIN is not set
BR2_TARGET_GENERIC_HOSTNAME=""
BR2_TARGET_GENERIC_ISSUE="NAS Revival Stage 1: shared legacy kernel; experimental chroot"
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_NAS_REVIVAL_STAGE1_PATH)/busybox.fragment"
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_DROPBEAR_SMALL=y
# BR2_PACKAGE_DROPBEAR_CLIENT is not set
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y
# BR2_PACKAGE_DROPBEAR_LEGACY_CRYPTO is not set
BR2_PACKAGE_DROPBEAR_LOCALOPTIONS_FILE="$(BR2_EXTERNAL_NAS_REVIVAL_STAGE1_PATH)/dropbear-localoptions.h"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_NAS_REVIVAL_STAGE1_PATH)/post-build.sh"
